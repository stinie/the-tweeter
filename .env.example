
# Local MongoDB connection settings.
# Use your own database credentials.
# Keep your actual .env file private.

MONGODB_URI=replace_with_your_own_mongodb_uri

# Port on which the Express server listens
PORT=3000

# Private signing key for JWT authentication.
# Generate your own secret. Never share it.
JWT_SECRET=replace_with_your_own_secret

# ========================================
# ENVIRONMENT
# ========================================

# development = local testing (HTTP / localhost)
# production  = live deployment (HTTPS / secure cookies)
NODE_ENV=development