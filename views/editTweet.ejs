<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📁</text></svg>">
  <title>Edit Tweet | Tweeter</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <%- include("partials/header") %>

  <main>
    <h1>Welcome to Tweeter</h1>

    <section>
      <h2>Edit a Tweet</h2>

      <form action="/tweets/edit/<%= tweet._id %>" method="POST">
        <label for="tweet-title">Title</label>
        <input
          type="text"
          id="tweet-title"
          name="title"
          value="<%= tweet.title %>"
          minlength="21"
          required
        >

        <label for="tweet-content">Tweet</label>
        <textarea
          id="tweet-content"
          name="tweet"
          maxlength="50"
          required
        ><%= tweet.tweet %></textarea>

        <button type="submit">Submit</button>
      </form>
    </section>

    <p><a href="/tweets/<%= tweet._id %>">Cancel</a></p>
  </main>
</body>

</html>