<!-- ADD TWEET -->
<section>
  <h2>Add a Tweet</h2>

  <form action="/addTweet" method="POST">
    <label for="tweet-title">Title</label>
    <input
      type="text"
      id="tweet-title"
      name="title"
      minlength="21"
      required
    >

    <label for="tweet-content">Tweet</label>
    <textarea
      id="tweet-content"
      name="tweet"
      maxlength="50"
      required
    ></textarea>

    <button type="submit">Submit</button>
  </form>
</section>